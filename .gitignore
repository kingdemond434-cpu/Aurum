# Nothing secret should ever be in this folder, but the repo is going public-ish
# (other AIs and you both write to it), so the guard is explicit rather than assumed.
*.key
*.token
*.env
secrets/
credentials*
*_token*
*_password*

# Local scratch
.DS_Store
Thumbs.db
*.tmp

# Python
__pycache__/
*.pyc
.venv/

# Local run artifacts — never evidence, never committed
acceptance_out/
state/
*.jsonl
backtest_out/
drift_out/

# Build artifact — regenerate with ./build_zip.sh, never commit.
# A committed zip goes stale the moment a module changes, and a packaged
# artifact that disagrees with the source is the failure mode this repo has
# already hit twice.
aurum_v2.zip
